#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable rnacos.service >/dev/null 2>&1 || true
        systemctl daemon-reload || true
    fi
    # 不自动删除数据目录和用户，避免误删用户数据。
    # 如需彻底清理：sudo rm -rf /var/lib/r-nacos && sudo userdel rnacos
fi

exit 0
